'use strict';

import { mkdtemp, chmod, open, popen, unlink, rmdir } from 'fs';
import { task } from 'uloop';

const bridge = '/usr/lib/xcloud-bypass/rpc-bridge';
const limits = {
	mode: 8, selection: 64, networks: 4096, devices: 4096,
	console: 1, browser: 1, fallback: 1, custom: 4096,
	ack: 1, peer: 15, profile: 32768, username: 127,
	password: 127, id: 64
};

function invoke(operation, args) {
	if (args == null)
		args = {};
	for (let name in keys(args)) {
		if (limits[name] == null || type(args[name]) != 'string' ||
		    length(args[name]) > limits[name] || index(args[name], '\0') >= 0)
			return { ok: false, error: 'Invalid input.' };
	}

	let directory = mkdtemp('/tmp/xcloud-rpc.XXXXXX');
	if (!directory)
		return { ok: false, error: 'Private staging is unavailable.' };

	let result = { ok: false, error: 'Operation failed. Check diagnostics over SSH.' };
	let names = keys(args);
	try {
		if (!chmod(directory, 0o700))
			die('staging');
		for (let name in names) {
			let file = open(directory + '/' + name, 'wxe', 0o600);
			if (!file)
				die('staging');
			let written = file.write(args[name]);
			let closed = file.close();
			if (written != length(args[name]) || !closed)
				die('staging');
		}
		let process = popen('exec setsid /usr/bin/timeout -s KILL 90 ' + bridge + ' ' + operation + ' ' + directory + ' 2>/dev/null', 'r');
		if (!process)
			die('worker');
		let output = process.read(131073);
		let code = process.close();
		if (code == 0 && output != null && length(output) <= 131072) {
			let value = json(output);
			if (type(value) == 'object' && value != null)
				result = value;
		}
	}
	catch (error) {
		result = { ok: false, error: 'Operation failed. Check diagnostics over SSH.' };
	}
	for (let name in names)
		unlink(directory + '/' + name);
	rmdir(directory);
	return result;
}

const jobs = {};
let sequence = 0;

function prune() {
	for (let id in keys(jobs)) {
		let job = jobs[id];
		if (job.worker && job.worker.finished() && job.state == 'running') {
			job.state = 'complete';
			job.result = { ok: false, error: 'Worker stopped. Check diagnostics over SSH.' };
			job.worker = null;
		}
		if (job.state == 'complete' && time() - job.created > 300)
			delete jobs[id];
	}
}

function method(operation, args) {
	return { args, call: function(request) {
		for (let name in keys(request.args)) {
			if (!(name in args) || type(request.args[name]) != 'string' ||
			    length(request.args[name]) > limits[name] || index(request.args[name], '\0') >= 0)
				return { ok: false, error: 'Invalid input.' };
		}
		prune();
		if (length(filter(values(jobs), j => j.state == 'running')) >= 4)
			return { ok: false, error: 'Busy. Try again shortly.' };
		if (length(jobs) >= 16) {
			for (let old in keys(jobs)) {
				if (jobs[old].state == 'complete') {
					delete jobs[old];
					break;
				}
			}
		}
		let id = sprintf('%d-%d', time(), ++sequence);
		let job = { state: 'running', created: time() };
		job.worker = task(() => invoke(operation, request.args), result => {
			job.state = 'complete';
			job.result = type(result) == 'object' && result != null ? result :
				{ ok: false, error: 'Worker stopped. Check diagnostics over SSH.' };
			job.worker = null;
		});
		if (!job.worker)
			return { ok: false, error: 'Unable to start operation.' };
		jobs[id] = job;
		return { ok: true, job: id };
	} };
}

const settings = {
	mode: '', selection: '', networks: '', devices: '', console: '',
	browser: '', fallback: '', custom: '', ack: '', peer: ''
};

return {
	'xcloud-bypass': {
		job: { args: { id: '' }, call: function(request) {
			if (type(request.args.id) != 'string' || length(request.args.id) > 64)
				return { ok: false, error: 'Invalid job identifier.' };
			prune();
			let job = jobs[request.args.id];
			return job ? { ok: true, state: job.state, result: job.result } :
				{ ok: false, error: 'Job expired or was not found.' };
		} },
		status: method('status', {}),
		doctor: method('doctor', {}),
		settings: method('settings', {}),
		clients: method('clients', {}),
		profiles: method('profiles', {}),
		profile_summary: method('profile_summary', { id: '' }),
		pending: method('pending', {}),
		import_profile: method('import_profile', { profile: '' }),
		set_credentials: method('set_credentials', { id: '', username: '', password: '' }),
		preview: method('preview', settings),
		apply: method('apply', settings),
		confirm: method('confirm', { id: '' }),
		reconnect: method('reconnect', { peer: '' }),
		enable: method('enable', { peer: '' }),
		disable: method('disable', { peer: '' }),
		rollback: method('rollback', { peer: '' }),
		uninstall: method('uninstall', { peer: '' })
	}
};

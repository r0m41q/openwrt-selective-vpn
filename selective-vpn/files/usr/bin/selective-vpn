#!/bin/sh
set -eu

. /usr/lib/selective-vpn/load.sh

svpn_cli_help() {
	cat <<'HELP'
Usage: selective-vpn COMMAND

Set up routing in LuCI under Services > Selective VPN.
These commands are for checks and recovery over SSH.

Commands:
  status      Show current state and routes as JSON
  doctor      Show redacted diagnostics as JSON
  confirm     Keep a pending change after checking router access
  disable     Stop selective routing
  rollback    Restore the previous confirmed configuration
  uninstall   Remove routing configuration and owned resources
  help        Show this help

Changes need confirmation within 120 seconds or they roll back.
HELP
}

svpn_cli_ask() {
	printf '%s' "$1" >&2
	IFS= read -r reply || return 1
	case "$reply" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# the SSH client address keeps its return route checked during the change
svpn_cli_peer() {
	peer=${SSH_CONNECTION:-}
	peer=${peer%% *}
	svpn_valid_ipv4 "$peer" && return 0
	printf 'Your SSH client IPv4 address: ' >&2
	IFS= read -r peer || return 1
	svpn_valid_ipv4 "$peer"
}

svpn_cli_change() {
	svpn_cli_peer || { printf 'An SSH client IPv4 address is required.\n' >&2; exit 1; }
	svpn_lifecycle "$1" "$peer"
	id=$(svpn_tx_pointer pending) || exit 0
	printf 'Check SSH and the router UI. The change rolls back after %s seconds unless confirmed.\n' "$SVPN_CONFIRM_SECONDS" >&2
	if svpn_cli_ask 'Confirm now? [y/N] '; then
		svpn_lifecycle confirm "$id"
		printf 'Confirmed.\n'
	else
		printf 'Run selective-vpn confirm to keep it.\n'
	fi
}

[ "$#" -eq 1 ] || { svpn_cli_help >&2; exit 1; }
case "$1" in
	status|doctor) svpn_report "$1" ;;
	confirm)
		[ "$(id -u)" -eq 0 ] || exit 1
		id=$(svpn_tx_pointer pending) || { printf 'No change is pending.\n' >&2; exit 1; }
		svpn_lifecycle confirm "$id" ;;
	disable|rollback)
		[ "$(id -u)" -eq 0 ] || exit 1
		svpn_cli_change "$1" ;;
	uninstall)
		[ "$(id -u)" -eq 0 ] || exit 1
		svpn_cli_ask 'Remove the routing configuration? [y/N] ' || exit 0
		svpn_cli_change uninstall ;;
	help|-h|--help) svpn_cli_help ;;
	*) svpn_cli_help >&2; exit 1 ;;
esac

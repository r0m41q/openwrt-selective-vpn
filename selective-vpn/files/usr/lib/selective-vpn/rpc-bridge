#!/bin/sh
set -eu

. /usr/lib/selective-vpn/load.sh
. /usr/share/libubox/jshn.sh
# jshn reads unset variables
set +u

[ "$#" -eq 2 ] && [ "$(id -u)" -eq 0 ] || exit 1
operation=$1
stage=$2
case "$operation" in
	status|doctor|settings|rules|clients|profiles|leases|profile_summary|pending|client_check|pbr_policies|import_profile|adopt_client|import_pbr|set_credentials|preview|apply|confirm|reconnect|enable|disable|rollback|uninstall) ;;
	*) exit 1 ;;
esac
case "$stage" in /tmp/selective-vpn-rpc.[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]) ;; *) exit 1 ;; esac
svpn_private_directory "$stage" || exit 1

case "$operation" in
	profile_summary|confirm) allowed=' id ' ;;
	import_profile) allowed=' profile ' ;;
	client_check|adopt_client) allowed=' client ' ;;
	pbr_policies) allowed=' mode selection ' ;;
	import_pbr) allowed=' mode selection rules ' ;;
	set_credentials) allowed=' id username password ' ;;
	preview) allowed=' mode selection networks rules ack peer ' ;;
	apply) allowed=' mode selection networks ack peer review ' ;;
	reconnect|enable|disable|rollback|uninstall) allowed=' peer ' ;;
	*) allowed=' ' ;;
esac
for input in "$stage"/* "$stage"/.[!.]* "$stage"/..?*; do
	[ -e "$input" ] || [ -L "$input" ] || continue
	name=${input##*/}
	case "$allowed" in *" $name "*) ;; *) exit 1 ;; esac
	svpn_private_file "$input" || exit 1
	case "$name" in
		profile) limit=32768 ;;
		rules) limit=32768 ;;
		networks) limit=4096 ;;
		username|password) limit=127 ;;
		ack) limit=1 ;;
		mode) limit=8 ;;
		peer) limit=15 ;;
		*) limit=64 ;;
	esac
	[ "$(wc -c < "$input")" -le "$limit" ] || exit 1
	if [ "$name" != profile ]; then
		# reject control bytes before command substitution can strip them
		case "$name" in
			networks|rules) printable='\12\40-\176\200-\377' ;;
			*) printable='\40-\176\200-\377' ;;
		esac
		[ "$(LC_ALL=C tr -d "$printable" < "$input" | wc -c)" -eq 0 ] || exit 1
	fi
done

case "$operation" in
	import_profile|adopt_client|import_pbr|client_check|pbr_policies|set_credentials|preview|settings|rules|clients|profiles|leases|profile_summary|pending)
		runtime=$(svpn_runtime_directory) || exit 1
		if [ ! -e "$runtime/lifecycle.lock" ] && [ ! -L "$runtime/lifecycle.lock" ]; then
			(umask 077; set -C; : > "$runtime/lifecycle.lock") 2>/dev/null || :
		fi
		svpn_private_file "$runtime/lifecycle.lock" || exit 1
		exec 8<> "$runtime/lifecycle.lock" || exit 1
		flock -w 3 8 || exit 4 ;;
esac

field() {
	case "$1" in mode|selection|networks|rules|ack|peer|review|profile|username|password|id|client) ;; *) return 1 ;; esac
	[ -e "$stage/$1" ] || { printf ''; return 0; }
	svpn_private_file "$stage/$1" || return 1
	[ "$(wc -c < "$stage/$1")" -le 32768 ] || return 1
	cat "$stage/$1"
}

profile_bundle() {
	printf '%s\n' "$1" | grep -Eq '^profile\.[a-zA-Z0-9]{8}$' || return 1
	svpn_private_directory "$SVPN_PROFILE_DIR/$1"
}

# an existing client named by the user, never one of ours
client_name() {
	client=$(field client) && svpn_valid_identifier "$client" && ! svpn_reserved_identifier "$client"
}

# the next tunnel name that no imported profile uses
next_tun() {
	blocked=$(for old in "$SVPN_PROFILE_DIR"/profile.*/client.ovpn; do
		[ -e "$old" ] || continue
		svpn_private_file "$old" || exit 1
		awk '$1 == "dev" && $2 ~ /^tun_sv[0-9]+$/ { print $2 }' "$old" || exit 1
	done) || return 1
	printf '%s\n' "$blocked" | svpn_select_tun
}

json_init
case "$operation" in
	status|doctor)
		svpn_report "$operation"
		exit ;;
	settings)
		runtime=$(svpn_runtime_directory) || exit 1
		work=$(mktemp -d "$runtime/settings.XXXXXXXX") || exit 1
		trap 'rm -rf -- "$work"' EXIT
		svpn_life_active "$work" || exit 1
		for key in mode selection networks ipv6_acknowledged; do
			value=$(svpn_life_setting "$work" "$key" || :)
			json_add_string "$key" "$value"
		done
		value=$(svpn_table_get "$work/app.table" main enabled || :)
		json_add_string enabled "$value" ;;
	rules)
		runtime=$(svpn_runtime_directory) || exit 1
		work=$(mktemp -d "$runtime/rules.XXXXXXXX") || exit 1
		trap 'rm -rf -- "$work"' EXIT
		value=$(svpn_rules_draft "$work") || exit 1
		json_add_string rules "$value"
		value=$(svpn_preset_catalog) || exit 1
		json_add_string presets "$value" ;;
	clients)
		value=$(svpn_discover_clients) || exit 1
		json_add_string clients "$value" ;;
	leases)
		value=$(svpn_routing_leases) || exit 1
		json_add_string leases "$value" ;;
	profiles)
		value=$(for bundle in "$SVPN_PROFILE_DIR"/profile.*; do
			[ -e "$bundle" ] || continue
			id=${bundle##*/}
			profile_bundle "$id" && svpn_private_file "$bundle/summary" || exit 1
			printf '%s\n' "$id"
		done) || exit 1
		json_add_string profiles "$value" ;;
	profile_summary)
		id=$(field id) && profile_bundle "$id" && svpn_private_file "$SVPN_PROFILE_DIR/$id/summary" || exit 1
		[ "$(wc -c < "$SVPN_PROFILE_DIR/$id/summary")" -le 4096 ] || exit 1
		value=$(cat "$SVPN_PROFILE_DIR/$id/summary") || exit 1
		json_add_string summary "$value"
		if svpn_private_file "$SVPN_PROFILE_DIR/$id/credentials"; then value=1; else value=0; fi
		json_add_boolean credentials_saved "$value" ;;
	pending)
		id=''
		if [ -e "$SVPN_PRIVATE_DIR/pending" ] || [ -L "$SVPN_PRIVATE_DIR/pending" ]; then
			id=$(svpn_tx_pointer pending) && svpn_tx_load "$id" || exit 1
			state=$(svpn_state_read "$tx/state") || exit 1
			case "$state" in preparing|armed|applying|applied|awaiting_confirmation|recovering|runtime_recovery|conflict) ;; *) exit 1 ;; esac
			json_add_string state "$state"
			if [ -e "$tx/deadline" ] && [ "$(svpn_state_read "$tx/boot")" = "$(svpn_boot_id)" ]; then
				deadline=$(svpn_state_read "$tx/deadline") && svpn_valid_uint "$deadline" 999999999 || exit 1
				now=$(svpn_uptime) && svpn_valid_uint "$now" 999999999 || exit 1
				remaining=$((deadline - now))
				[ "$remaining" -ge 0 ] || remaining=0
				[ "$remaining" -le "$SVPN_CONFIRM_SECONDS" ] || remaining=$SVPN_CONFIRM_SECONDS
				json_add_int seconds_remaining "$remaining"
			fi
		fi
		json_add_string id "$id" ;;
	import_profile)
		svpn_private_file "$stage/profile" || exit 1
		tun=$(next_tun) || exit 1
		bundle=$(svpn_profile_import "$tun" < "$stage/profile") || exit 1
		id=${bundle##*/}
		profile_bundle "$id" || exit 1
		json_add_string id "$id" ;;
	client_check)
		client_name || exit 1
		value=$(svpn_client_check "$client") || exit 1
		json_add_string problems "$value" ;;
	adopt_client)
		client_name || exit 1
		tun=$(next_tun) || exit 1
		bundle=$(svpn_profile_adopt "$client" "$tun") || exit 1
		id=${bundle##*/}
		profile_bundle "$id" || exit 1
		json_add_string id "$id" ;;
	pbr_policies|import_pbr)
		mode=$(field mode) && selection=$(field selection) || exit 1
		case "$mode" in
			managed) profile_bundle "$selection" || exit 1 ;;
			external) svpn_valid_identifier "$selection" && ! svpn_reserved_identifier "$selection" || exit 1 ;;
			*) exit 1 ;;
		esac
		save=0
		if [ "$operation" = import_pbr ]; then
			save=1
			runtime=$(svpn_runtime_directory) || exit 1
			work=$(mktemp -d "$runtime/rules.XXXXXXXX") || exit 1
			trap 'rm -rf -- "$work"' EXIT
			# keep the rows edited in LuCI before adding imported ones
			if ! field rules | svpn_rules_save "$work"; then
				json_add_boolean ok 0
				json_add_string code rules
				json_dump
				exit 0
			fi
		fi
		value=$(svpn_pbr_import "$mode" "$selection" "$save") || exit 1
		json_add_string policies "$value"
		if [ "$save" = 1 ]; then
			value=$(svpn_rules_draft "$work") || exit 1
			json_add_string rules "$value"
		fi ;;
	set_credentials)
		id=$(field id) && profile_bundle "$id" || exit 1
		username=$(field username) && password=$(field password) || exit 1
		printf '%s\n%s\n' "$username" "$password" | svpn_profile_credentials "$SVPN_PROFILE_DIR/$id" || exit 1 ;;
	preview|apply)
		mode=$(field mode) && selection=$(field selection) && networks=$(field networks) &&
			ack=$(field ack) && peer=$(field peer) || exit 1
		[ "$ack" = 1 ] && svpn_valid_ipv4 "$peer" || exit 1
		networks=$(svpn_normalize_list identifier "$networks") || exit 1
		if [ "$operation" = preview ]; then
			# previewing saves the edited rows as the draft, routing only changes on apply
			runtime=$(svpn_runtime_directory) || exit 1
			work=$(mktemp -d "$runtime/rules.XXXXXXXX") || exit 1
			trap 'rm -rf -- "$work"' EXIT
			if ! field rules | svpn_rules_save "$work"; then
				json_add_boolean ok 0
				json_add_string code rules
				json_dump
				exit 0
			fi
			svpn_routing_preview "$mode" "$selection" "$networks"
			exit
		else
			svpn_review=$(field review) || exit 1
			printf '%s\n' "$svpn_review" | grep -Eq '^[a-f0-9]{64}$' || exit 1
			svpn_lifecycle apply "$mode" "$selection" "$networks" "$ack" "$peer" >/dev/null || exit 1
			id=$(svpn_tx_pointer pending || :)
			json_add_string id "$id"
		fi ;;
	confirm)
		id=$(field id) && svpn_state_id "$id" || exit 1
		svpn_lifecycle confirm "$id" >/dev/null || exit 1 ;;
	reconnect|enable|disable|rollback|uninstall)
		peer=$(field peer) && svpn_valid_ipv4 "$peer" || exit 1
		svpn_lifecycle "$operation" "$peer" >/dev/null || exit 1
		id=$(svpn_tx_pointer pending || :)
		json_add_string id "$id" ;;
esac
json_add_boolean ok 1
json_dump

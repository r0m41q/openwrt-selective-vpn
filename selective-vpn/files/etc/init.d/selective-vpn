#!/bin/sh /etc/rc.common

START=18
STOP=89
USE_PROCD=1

boot() {
	/usr/lib/selective-vpn/control boot
	start
}

start_service() {
	procd_open_instance recovery
	procd_set_param command /usr/lib/selective-vpn/supervise
	procd_set_param respawn 3600 3 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	/usr/lib/selective-vpn/signal-event
}

service_triggers() {
	procd_add_reload_trigger selective-vpn network firewall openvpn pbr dhcp
}

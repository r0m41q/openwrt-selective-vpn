#!/bin/sh
set -eu

. /usr/lib/xcloud-bypass/load.sh
. /usr/share/libubox/jshn.sh

[ "$#" -eq 2 ] && [ "$(id -u)" -eq 0 ] || exit 1
operation=$1
stage=$2
case "$operation" in
	status|doctor|settings|clients|profile_summary|pending|import_profile|set_credentials|preview|apply|confirm|enable|disable|rollback|uninstall) ;;
	*) exit 1 ;;
esac
case "$stage" in /tmp/xcloud-rpc.[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]) ;; *) exit 1 ;; esac
xcb_private_directory "$stage" || exit 1

case "$operation" in
	profile_summary|confirm) allowed=' id ' ;;
	import_profile) allowed=' profile ' ;;
	set_credentials) allowed=' id username password ' ;;
	preview|apply) allowed=' mode selection networks devices console browser fallback custom ack peer ' ;;
	enable|disable|rollback|uninstall) allowed=' peer ' ;;
	*) allowed=' ' ;;
esac
for input in "$stage"/* "$stage"/.[!.]* "$stage"/..?*; do
	[ -e "$input" ] || [ -L "$input" ] || continue
	name=${input##*/}
	case "$allowed" in *" $name "*) ;; *) exit 1 ;; esac
	xcb_private_file "$input" || exit 1
	case "$name" in
		profile) limit=32768 ;;
		networks|devices|custom) limit=4096 ;;
		username|password) limit=127 ;;
		console|browser|fallback|ack) limit=1 ;;
		mode) limit=8 ;;
		peer) limit=15 ;;
		*) limit=64 ;;
	esac
	[ "$(wc -c < "$input")" -le "$limit" ] || exit 1
	if [ "$name" != profile ]; then
		# reject control bytes before command substitution can strip them
		case "$name" in
			networks|devices|custom) printable='\12\40-\176\200-\377' ;;
			*) printable='\40-\176\200-\377' ;;
		esac
		[ "$(LC_ALL=C tr -d "$printable" < "$input" | wc -c)" -eq 0 ] || exit 1
	fi
done

case "$operation" in
	import_profile|set_credentials|preview|settings)
		runtime=$(xcb_runtime_directory) || exit 1
		if [ ! -e "$runtime/lifecycle.lock" ] && [ ! -L "$runtime/lifecycle.lock" ]; then
			(umask 077; set -C; : > "$runtime/lifecycle.lock") 2>/dev/null || :
		fi
		xcb_private_file "$runtime/lifecycle.lock" || exit 1
		exec 8<> "$runtime/lifecycle.lock" || exit 1
		flock -w 3 8 || exit 4 ;;
esac

field() {
	case "$1" in mode|selection|networks|devices|console|browser|fallback|custom|ack|peer|profile|username|password|id) ;; *) return 1 ;; esac
	[ -e "$stage/$1" ] || { printf ''; return 0; }
	xcb_private_file "$stage/$1" || return 1
	[ "$(wc -c < "$stage/$1")" -le 32768 ] || return 1
	cat "$stage/$1"
}

profile_bundle() {
	printf '%s\n' "$1" | grep -Eq '^profile\.[a-zA-Z0-9]{8}$' || return 1
	xcb_private_directory "$XCB_PROFILE_DIR/$1"
}

json_init
case "$operation" in
	status|doctor)
		xcb_report "$operation"
		exit ;;
	settings)
		runtime=$(xcb_runtime_directory) || exit 1
		work=$(mktemp -d "$runtime/settings.XXXXXXXX") || exit 1
		trap 'rm -rf -- "$work"' EXIT
		xcb_life_active "$work" || exit 1
		for key in mode selection networks devices console browser fallback custom ipv6_acknowledged; do
			value=$(xcb_life_setting "$work" "$key" || :)
			json_add_string "$key" "$value"
		done
		value=$(xcb_table_get "$work/app.table" main enabled || :)
		json_add_string enabled "$value" ;;
	clients)
		value=$(xcb_setup_clients) || exit 1
		json_add_string clients "$value" ;;
	profile_summary)
		id=$(field id) && profile_bundle "$id" && xcb_private_file "$XCB_PROFILE_DIR/$id/summary" || exit 1
		value=$(cat "$XCB_PROFILE_DIR/$id/summary") || exit 1
		json_add_string summary "$value" ;;
	pending)
		id=$(xcb_tx_pointer pending || :)
		json_add_string id "$id" ;;
	import_profile)
		xcb_private_file "$stage/profile" || exit 1
		blocked=$(for old in "$XCB_PROFILE_DIR"/profile.*/client.ovpn; do
			[ -e "$old" ] || continue
			xcb_private_file "$old" || exit 1
			awk '$1 == "dev" && $2 ~ /^tun_xc[0-9]+$/ { print $2 }' "$old" || exit 1
		done) || exit 1
		tun=$(printf '%s\n' "$blocked" | xcb_select_tun) || exit 1
		bundle=$(xcb_profile_import "$tun" < "$stage/profile") || exit 1
		id=${bundle##*/}
		profile_bundle "$id" || exit 1
		json_add_string id "$id" ;;
	set_credentials)
		id=$(field id) && profile_bundle "$id" || exit 1
		username=$(field username) && password=$(field password) || exit 1
		printf '%s\n%s\n' "$username" "$password" | xcb_profile_credentials "$XCB_PROFILE_DIR/$id" || exit 1 ;;
	preview|apply)
		mode=$(field mode) && selection=$(field selection) && networks=$(field networks) && devices=$(field devices) &&
		console=$(field console) && browser=$(field browser) && fallback=$(field fallback) && custom=$(field custom) &&
		ack=$(field ack) && peer=$(field peer) || exit 1
		[ "$ack" = 1 ] && xcb_valid_ipv4 "$peer" && xcb_valid_bool "$console" &&
			xcb_valid_bool "$browser" && xcb_valid_bool "$fallback" || exit 1
		if [ "$operation" = preview ]; then
			value=$(xcb_setup_preview "$mode" "$selection" "$networks" "$devices" "$console" "$browser" "$fallback" "$custom") || exit 1
			json_add_string preview "$value"
		else
			xcb_lifecycle apply "$mode" "$selection" "$networks" "$devices" "$console" "$browser" "$fallback" "$custom" "$ack" "$peer" >/dev/null || exit 1
			id=$(xcb_tx_pointer pending || :)
			json_add_string id "$id"
		fi ;;
	confirm)
		id=$(field id) && xcb_state_id "$id" || exit 1
		xcb_lifecycle confirm "$id" >/dev/null || exit 1 ;;
	enable|disable|rollback|uninstall)
		peer=$(field peer) && xcb_valid_ipv4 "$peer" || exit 1
		xcb_lifecycle "$operation" "$peer" >/dev/null || exit 1
		id=$(xcb_tx_pointer pending || :)
		json_add_string id "$id" ;;
esac
json_add_boolean ok 1
json_dump
